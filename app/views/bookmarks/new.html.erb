<div class="container mt-5">
<h1>Add a movie to <%= @list.name %></h1>

<%= simple_form_for [@list, @bookmark] do |form| %>
  <%= form.association :movie %><br>
  <%= form.input :comment %>
  <%= form.submit "Add movie", class: "btn btn-primary mt-3" %>
  <%= link_to "Cancel", list_path(@list), class: "btn btn-outline-secondary mt-3 ms-2" %>
<% end %>
</div>
