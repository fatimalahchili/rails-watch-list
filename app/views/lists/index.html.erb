<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My lists 🎞️🎥</h1>
    <%= link_to "Create a new list", new_list_path, class: "btn btn-primary" %>
  </div>

  <ul>
    <% @lists.each do |list| %>
      <li><%= link_to list.name, list_path(list) %></li>
    <% end %>
  </ul>
</div>
